diff --git a/build-tools/fix11.config b/build-tools/fix11.config
index 8c9c7b8cc..19d24dbfc 100644
--- a/build-tools/fix11.config
+++ b/build-tools/fix11.config
@@ -1,4 +1,11 @@
 # SPDX-License-Identifier: GPL-2.0
+#
+# 【参考副本 — 不参与构建, 勿在此处改配置】
+# build-tools/build_full.sh 只执行 `make blossom_defconfig`,
+# 本文件从未被 merge_config/olddefconfig 应用, 改它不会改变任何编译结果。
+# 真正的配置源是 arch/arm64/configs/blossom_defconfig。
+# 改配置流程: 改 defconfig -> make blossom_defconfig -> bash build-tools/check_config.sh out/.config
+#
 # v11: 无指纹/NFC 硬件,关闭噪音项
 # CONFIG_MICROTRUST_FP_DRIVER is not set
 # CONFIG_FPC_FINGERPRINT is not set
@@ -9,6 +16,26 @@
 # 生产化
 # CONFIG_DEBUG_PREEMPT is not set
 
+# 可加载模块支持(勿拆)
+# MODULES 在 Kconfig 里没有 default y, defconfig 一旦漏写就静默落成 n:
+# /proc/modules 消失, /vendor/lib/modules 下 14 个 .ko(bt_drv/gps_drv/
+# fmradio_drv/fpsgo/met/wmt…)一个都加载不了。六份参照配置全为 y。
+CONFIG_MODULES=y
+CONFIG_MODULE_UNLOAD=y
+CONFIG_STRICT_MODULE_RWX=y
+
+# 因开 MODULES 而必须显式钉死的 tristate(勿拆)
+# 这 4 项 defconfig 原本一个字都没写。CONFIG_MODULES=n 时 Kconfig 会把所有
+# tristate 的 m 钳成 y,它们于是"碰巧"被编进内核;一旦打开 MODULES,钳制消失,
+# 各自回落到 m 默认值 —— 而我们只出 Image.gz、根本不打包 .ko,驱动直接消失。
+# 实测代价(刷机 #7): CONFIG_BATTERY_MT6357 变 m ->
+#   battery 这个 power_supply 不注册 -> 内核刷屏 "Couldn't get bat_psy" ->
+#   /sys/class/power_supply/ 下没有 battery -> 状态栏电量 0 / unknown。
+CONFIG_BATTERY_MT6357=y
+CONFIG_SND_SOC_MT6357_ACCDET=y
+CONFIG_TCP_CONG_WESTWOOD=y
+CONFIG_WIREGUARD=y
+
 # TEE 全家(Keymaster/DRM 依赖,勿拆)
 CONFIG_TEE=y
 CONFIG_MICROTRUST_TEE_SUPPORT=y
@@ -22,5 +49,14 @@ CONFIG_MICROTRUST_TZ_LOG=y
 # 防御纵深
 CONFIG_ARM64_SW_TTBR0_PAN=y
 
-# ION secure heap(Widevine L1 链)
+# 安全媒体链(Widevine L1 / SVP,勿拆)
+# 这组断了内核照样能开机、TEE 也正常,但 ION secure heap 和 SVP 通路没了:
+# 校园/DRM 类 APP 绑定设备硬件密钥会失败。SEC_VIDEO_PATH 是 trusted_mem 里
+# MTK_WFD_SMEM_SUPPORT 的前置(见 trusted_mem/Kconfig),缺它整条链只开一半。
+CONFIG_MTK_SEC_VIDEO_PATH_SUPPORT=y
+CONFIG_MTK_DRM_KEY_MNG_SUPPORT=y
+CONFIG_MTK_ION_SEC_HEAP=y
 CONFIG_MTK_SECURE_MEM_SUPPORT=y
+CONFIG_HAVE_MTK_TRUSTED_MEMORY_SUBSYSTEM=y
+CONFIG_MTK_TRUSTED_MEMORY_SUBSYSTEM=y
+CONFIG_MTK_SSMR=y
