# Debug 内核配置 fragment（批0+批1）
# 与 blossom_defconfig 合并生成 out-debug/.config；正式 defconfig 一字不动。
# 合并/断言/构建流程见 build-tools/build_debug.sh

# —— 批0: 版本串区分（UTS: 4.19.325-dandelion-debug）——
CONFIG_LOCALVERSION="-dandelion-debug"

# —— 批1: 卡死排查三件套（周期检查, 开销≈0）——
# D 状态任务超时打印调用栈 -> dmesg/pstore
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
# 软锁检测（hrtimer 周期, 仅告警不 panic, 保持可观察）
CONFIG_SOFTLOCKUP_DETECTOR=y
# workqueue 超时检测
CONFIG_WQ_WATCHDOG=y

# —— 批1: 调试基础设施 ——
# 4.19 无依赖；无 root 下多数接口不可读, 收益走 dmesg/ramoops 路径
CONFIG_DEBUG_FS=y
# pr_debug 运行时可控；控制走 cmdline dyndbg=（不依赖 root 读 debugfs）
CONFIG_DYNAMIC_DEBUG=y
